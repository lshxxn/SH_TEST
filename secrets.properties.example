# 이 파일을 복사해서 이름을 secrets.properties 로 바꾸고 값을 채우세요.
# secrets.properties 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않습니다.
# 키를 채팅이나 메신저에 붙여 넣지 마세요.

# 제미나이 API 키 (Google AI Studio > Get API key)
GEMINI_API_KEY=

# (선택) 다른 제미나이 모델을 쓰려면
# GEMINI_MODEL=gemini-flash-lite-latest

# (선택) 스킬 주소 보호용 토큰. 정하면 챗봇 스킬 URL 끝에 ?token=이값 을 붙여야 합니다.
# NEWSBOT_SKILL_TOKEN=
