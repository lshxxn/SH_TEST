# /etc/systemd/system/kakao-news-bot.service
[Unit]
Description=Kakao News Bot (매일 아침 뉴스 발송)
After=network-online.target
Wants=network-online.target

[Service]
User=newsbot
WorkingDirectory=/opt/kakao-news-bot
EnvironmentFile=/opt/kakao-news-bot/newsbot.env
ExecStart=/usr/bin/java -jar /opt/kakao-news-bot/kakao-news-bot.jar
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
