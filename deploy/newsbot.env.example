# 이 파일을 newsbot.env 로 복사해서 값을 채우세요. (chmod 600 권장, 깃에 올리지 마세요)

# 관리용 토큰 — 길고 임의적인 값 (예: openssl rand -hex 24)
NEWSBOT_ADMIN_TOKEN=

# ① 나에게 보내기
KAKAO_ENABLED=true
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/kakao/callback
KAKAO_TOKEN_FILE=/opt/kakao-news-bot/data/kakao-token.json

# ② 카카오톡 채널 브랜드 메시지 (솔라피)
SOLAPI_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_FROM=
SOLAPI_RECIPIENTS=

# 한글 설정값이 깨지지 않도록
LANG=C.UTF-8
